<UserControl x:Class="RCMenuManager.Views.Controls.ContextMenuPreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource SectionDivider}" Padding="14,10">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Path Width="14" Height="14"
                          Stroke="{StaticResource MutedTextBrush}" StrokeThickness="1.3"
                          StrokeStartLineCap="Round" StrokeLineJoin="Round"
                          Data="M2,2 H10 V6 H8 L6,8 L4,6 H2 Z M2,9 H12 V13 H2 Z"
                          VerticalAlignment="Center" />
                    <TextBlock Margin="8,0,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="12" VerticalAlignment="Center">
                        <Run Text="目标：" />
                        <Run Text="{Binding SelectedScope.Label, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                    </TextBlock>
                </StackPanel>
                <CheckBox Content="显示 Shift 项"
                          IsChecked="{Binding ShowExtended}"
                          HorizontalAlignment="Right" VerticalAlignment="Center"
                          FontSize="12" Foreground="{StaticResource MutedTextBrush}"
                          ToolTip="Extended 项只有在按住 Shift 右键时才会出现" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" x:Name="PreviewSurface" Background="Transparent"
              PreviewMouseRightButtonDown="OnPreviewSurfaceRightClick">
            <Border Margin="18" Padding="26,20" CornerRadius="10"
                    BorderBrush="{StaticResource PanelBorder}" BorderThickness="1"
                    Background="{StaticResource PanelBackground}"
                    VerticalAlignment="Top"
                    SnapsToDevicePixels="True">
                <StackPanel>
                    <Border Width="44" Height="44" CornerRadius="22"
                            Background="{StaticResource AccentSubtleBrush}"
                            HorizontalAlignment="Left">
                        <Path Width="22" Height="22"
                              Stroke="{StaticResource AccentBrush}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"
                              Data="M5,4 H19 V20 H5 Z M9,9 H15 M9,13 H15 M9,17 H13"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Margin="0,12,0,0" Style="{StaticResource TitleText}">
                        <Run Text="右键预览 " />
                        <Run Text="{Binding SelectedScope.Label, Mode=OneWay}" />
                        <Run Text=" 的菜单" />
                    </TextBlock>
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource MutedText}" TextWrapping="Wrap">
                        <Run Text="在预览区任意位置" />
                        <Run Text="右键" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                        <Run Text="，即可看到资源管理器为当前作用域生成的完整菜单 —— 菜单由 Windows 自己构建，项目顺序、文字、图标、快捷键、置灰状态与真实右键菜单一致。" />
                    </TextBlock>
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource MutedText}" TextWrapping="Wrap">
                        <Run Text="不属于本工具的项为只读参考；点击注册表项会同步选中，右侧可" />
                        <Run Text="查看 / 编辑 / 删除 / 启停" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                        <Run Text="。" />
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
