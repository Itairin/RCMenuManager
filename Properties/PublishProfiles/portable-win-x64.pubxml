<?xml version="1.0" encoding="utf-8"?>
<!--
  Single-file, self-contained, portable build.

    dotnet publish RCMenuManager.csproj -p:PublishProfile=portable-win-x64

  Produces exactly one file: publish\portable\RCMenuManager.exe.
  No installer, no .NET runtime needed on the target machine, no loose
  Resources\presets.json (it is embedded in the assembly).

  Notes:
  - PublishTrimmed is deliberately NOT enabled: WPF is not trim-safe.
  - IncludeNativeLibrariesForSelfExtract is required because WPF ships native
    DLLs (wpfgfx_cor3, PresentationNative_cor3, D3DCompiler_47_cor3). They are
    unpacked to %TEMP%\.net\ on first launch and reused afterwards.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <PublishDir>$(MSBuildProjectDirectory)\publish\portable\</PublishDir>
  </PropertyGroup>
</Project>
