<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Keep the package source list explicit so restores are reproducible on any
       machine (dev box, CI, fresh clone). Do not add a machine-specific fallback
       folder here: pointing at %USERPROFILE%\.nuget\packages as a *source* makes
       `dotnet restore` fail everywhere else with NU1301/MSB4018. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
